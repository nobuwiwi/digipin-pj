{
  "expo": {
    "name": "デジピン",
    "slug": "golf-evidence",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "backgroundColor": "#1a6b4c",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.golfevidence.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-dev-client",
      "expo-image-picker",
      "expo-asset"
    ],
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a6b4c"
      },
      "package": "com.golfevidence.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "extra": {
      "apiBaseUrl": "https://digipin-pj-production.up.railway.app",
      "eas": {
        "projectId": "cf253ea1-5fba-4006-ad97-30e80b857d1c"
      }
    }
  }
}
