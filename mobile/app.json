{
  "expo": {
    "name": "デジピン",
    "slug": "golf-evidence",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#1a6b4c",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.golfevidence.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "証拠画像撮影およびQRコードスキャンのためにカメラを使用します。",
        "NSPhotoLibraryUsageDescription": "証拠画像選択のために写真ライブラリを使用します。"
      }
    },
    "plugins": [
      "expo-dev-client",
      "expo-image-picker",
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "証拠画像撮影およびQRコードスキャンのためにカメラを使用します。"
        }
      ]
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a6b4c"
      },
      "package": "com.golfevidence.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "extra": {
      "apiBaseUrl": "https://digipin-pj-production.up.railway.app",
      "eas": {
        "projectId": "cf253ea1-5fba-4006-ad97-30e80b857d1c"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/cf253ea1-5fba-4006-ad97-30e80b857d1c"
    }
  }
}
